# Kopieren nach .env und Werte anpassen. Die .env wird NICHT committet.
# Homepage ersetzt {{HOMEPAGE_VAR_...}} in config/services.yaml durch diese Werte.
TZ=Europe/Vienna
HOMEPAGE_VAR_PIHOLE_PASSWORD=gleiches-passwort-wie-pihole
HOMEPAGE_VAR_NPM_USER=admin@example.com
HOMEPAGE_VAR_NPM_PASSWORD=npm-passwort
# Portainer: Benutzer > Access tokens. Umgebungs ID steht in der URL (#!/3/docker/...)
HOMEPAGE_VAR_PORTAINER_KEY=ptr_xxxxxxxx
HOMEPAGE_VAR_PORTAINER_ENV=3
# Nextcloud: occ config:app:set serverinfo token --value <token>
HOMEPAGE_VAR_NEXTCLOUD_TOKEN=langer-zufallstoken
HOMEPAGE_VAR_GRAFANA_USER=admin
HOMEPAGE_VAR_GRAFANA_PASSWORD=grafana-passwort
